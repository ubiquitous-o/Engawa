{
  "manifest_version": 3,
  "name": "Engawa",
  "description": "Engawa: a side panel with favorites, bookmarks, GitHub pull requests and open tabs beside the page",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Engawa",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Toggle the side panel"
    }
  },
  "permissions": [
    "sidePanel",
    "bookmarks",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "notifications",
    "favicon"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}

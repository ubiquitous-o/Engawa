{
  "manifest_version": 3,
  "name": "Engawa",
  "description": "縁側。お気に入り・ブックマーク・GitHub PR・開いているタブを横に置くサイドパネル",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Engawa",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+S" },
      "description": "サイドパネルを開閉"
    }
  },
  "permissions": [
    "sidePanel",
    "bookmarks",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "notifications",
    "favicon"
  ],
  "host_permissions": ["https://api.github.com/*"],
  "optional_host_permissions": ["https://*/*"]
}
